# Copy to .env and fill in. Never commit .env.

# Which AI provider analyzes notices: gemini (default) | openrouter | anthropic
AI_PROVIDER=gemini

# Gemini (free tier key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded (429/5xx); empty = no fallback
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Where daily-quota cooldowns are remembered between runs
# GEMINI_COOLDOWN_FILE=data/gemini-cooldown.json
# Pause between AI calls during ingestion (free-tier per-minute limit)
# INGEST_AI_DELAY_MS=4000

# OpenRouter (only if AI_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Anthropic (only if AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# POC_DB_PATH=data/poc.db
