{
  "name": "inha-notice-poc",
  "version": "1.0.0",
  "description": "POC: crawl a real Inha notice, store it, analyze it with Claude",
  "scripts": {
    "crawl": "tsx src/cli.ts crawl",
    "poc": "tsx src/cli.ts poc",
    "show": "tsx src/cli.ts show",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "tsx --test test/*.test.ts",
    "ingest": "tsx src/cli.ts ingest",
    "api": "tsx watch src/server.ts",
    "web": "vite --config web/vite.config.ts",
    "dev": "concurrently -k -n api,web -c auto \"npm:api\" \"npm:web\"",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.24.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.3",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true
}
